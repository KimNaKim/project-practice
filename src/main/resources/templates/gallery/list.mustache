{{> layout/header}}

        <main class="container py-5">
            <div class="d-flex justify-content-between align-items-end mb-5 border-bottom border-secondary border-opacity-10 pb-4">
                <div>
                    <h2 class="display-6 fw-black text-primary mb-1">포토 갤러리</h2>
                    <p class="text-secondary fw-medium m-0 small">커뮤니티 회원들의 소중한 순간들을 만나보세요.</p>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-primary btn-sm rounded-pill px-3 fw-bold">최신순</button>
                    <button class="btn btn-light bg-white border border-secondary border-opacity-10 btn-sm rounded-pill px-3 fw-bold text-secondary">인기순</button>
                </div>
            </div>

            <div class="gallery-grid">
                {{#galleries}}
                <!-- Item -->
                <div class="gallery-item">
                    <div class="gallery-thumb-wrapper shadow-sm mb-3">
                        <img src="{{thumbnailPath}}" alt="Gallery">
                    </div>
                    <h3 class="h6 fw-bold text-dark mb-1 hover-primary transition-colors">{{title}}</h3>
                    <p class="text-secondary small m-0 fw-medium">등록일: {{createdAt}}</p>
                </div>
                {{/galleries}}
                {{^galleries}}
                <div class="w-100 text-center py-5 text-secondary">등록된 갤러리 게시글이 없습니다.</div>
                {{/galleries}}
            </div>
        </main>

{{> layout/footer}}
