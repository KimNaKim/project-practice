{{> layout/admin-header}}
<div class="p-4 p-lg-5">
    <div class="max-w-4xl mx-auto">
        <form action="/admin/galleries/save" method="post" enctype="multipart/form-data">
            <div class="d-flex justify-content-between align-items-end mb-5">
                <div>
                    <h2 class="display-6 fw-bold text-dark mb-2">새 갤러리 게시글 작성</h2>
                    <p class="text-secondary fw-medium mb-0">캠핑장의 생생한 현장 소식을 사진과 함께 공유하세요.</p>
                </div>
                <div class="d-flex gap-2">
                    <button type="button" onclick="location.href='/admin/galleries'" class="btn btn-light px-4 py-2.5 fw-bold text-secondary border border-secondary border-opacity-10 bg-white rounded-3">취소</button>
                    <button type="submit" class="btn btn-primary px-4 py-2.5 fw-bold shadow-md border-0 rounded-3">게시하기</button>
                </div>
            </div>

            <div class="fh-card shadow-sm border-0 p-4 p-md-5 bg-white rounded-4">
                <div class="mb-4">
                    <label class="form-label small fw-bold text-dark">제목</label>
                    <input type="text" name="title" class="form-control py-3 shadow-none border-secondary border-opacity-25 bg-light bg-opacity-50 rounded-3" placeholder="포스트의 제목을 입력하세요 (예: 2024년 봄맞이 불멍 축제)" required>
                </div>

                <div class="mb-5">
                    <label class="form-label small fw-bold text-dark mb-3">이미지 업로드</label>
                    <div class="gallery-upload-zone shadow-sm mb-4 rounded-4 position-relative" style="cursor: pointer;" onclick="document.getElementById('images').click();">
                        <div class="mx-auto bg-white rounded-circle shadow-sm d-flex align-items-center justify-content-center mb-3 preview-img-box-large">
                            <span class="material-symbols-outlined text-primary fs-2">cloud_upload</span>
                        </div>
                        <h3 class="h6 fw-bold text-dark mb-1">클릭하여 사진을 선택하세요</h3>
                        <p class="text-secondary text-xxs">최대 20MB 이하의 고화질 JPG, PNG 파일 (여러 장 선택 가능)</p>
                        <input type="file" id="images" name="images" multiple class="d-none" accept="image/*" required onchange="previewImages(this)">
                    </div>

                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="material-symbols-outlined text-primary fs-5">visibility</span>
                        <h4 class="small fw-bold text-dark m-0">업로드 예정 이미지</h4>
                    </div>
                    <div id="preview-grid" class="preview-grid">
                        <div class="preview-item border-dashed d-flex align-items-center justify-content-center bg-light opacity-50">
                            <span class="material-symbols-outlined text-secondary fs-2">add_photo_alternate</span>
                        </div>
                    </div>
                </div>

                <div class="mb-0">
                    <label class="form-label small fw-bold text-dark mb-2">상세 설명</label>
                    <div class="fh-editor-container">
                        <div class="fh-editor-toolbar bg-light bg-opacity-50">
                            <button type="button" class="btn btn-icon btn-sm"><span class="material-symbols-outlined fs-6">format_bold</span></button>
                            <button type="button" class="btn btn-icon btn-sm"><span class="material-symbols-outlined fs-6">format_italic</span></button>
                            <button type="button" class="btn btn-icon btn-sm"><span class="material-symbols-outlined fs-6">format_list_bulleted</span></button>
                            <button type="button" class="btn btn-icon btn-sm"><span class="material-symbols-outlined fs-6">link</span></button>
                        </div>
                        <textarea name="content" class="fh-editor-content bg-transparent" rows="8" placeholder="사진에 대한 이야기나 설명을 자유롭게 작성해주세요..." required></textarea>
                    </div>
                </div>
            </div>
        </form>

        <script>
            function previewImages(input) {
                const previewGrid = document.getElementById('preview-grid');
                previewGrid.innerHTML = '';
                
                if (input.files) {
                    Array.from(input.files).forEach(file => {
                        const reader = new FileReader();
                        reader.onload = function(e) {
                            const div = document.createElement('div');
                            div.className = 'preview-item shadow-sm';
                            div.innerHTML = `<img src="${e.target.result}" alt="Preview">`;
                            previewGrid.appendChild(div);
                        }
                        reader.readAsDataURL(file);
                    });
                }
            }
        </script>

        <footer class="mt-5 text-center">
            <p class="text-secondary opacity-50 text-xxs">© 2024 Camping Jigi. All rights reserved.</p>
        </footer>
    </div>
</div>
{{> layout/admin-footer}}
