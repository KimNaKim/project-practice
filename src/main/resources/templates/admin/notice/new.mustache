{{> layout/admin-header}}
<div class="p-5" style="max-width: 896px; margin: 0 auto;">
    <form action="{{#notice}}/admin/notices/update/{{id}}{{/notice}}{{^notice}}/admin/notices/save{{/notice}}" method="post">
        <!-- Page Title Section -->
        <div class="d-flex justify-content-between align-items-center mb-5">
            <div>
                <h2 class="display-6 fw-bold text-dark mb-1 tracking-tight">{{#notice}}공지사항 수정{{/notice}}{{^notice}}새 공지사항 작성{{/notice}}</h2>
                <p class="text-secondary small mt-1">캠핑지기 웹사이트 및 앱에 노출될 {{#notice}}기존 공지사항을 수정합니다.{{/notice}}{{^notice}}새로운 공지사항을 등록합니다.{{/notice}}</p>
            </div>
            <div class="d-flex gap-3">
                <button type="button" onclick="location.href='/admin/notices'" class="btn btn-light px-4 py-2.5 fw-bold text-secondary border bg-white rounded-3 small">취소</button>
                <button type="submit" class="btn btn-primary px-4 py-2.5 fw-bold shadow-md border-0 rounded-3 small">{{#notice}}수정하기{{/notice}}{{^notice}}게시하기{{/notice}}</button>
            </div>
        </div>

        <div class="space-y-6">
            <!-- Form Card -->
            <div class="form-card shadow-sm">
                <!-- Category & Title -->
                <div class="row g-4 mb-4">
                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-dark mb-2">카테고리</label>
                        <select name="category" class="form-select py-2.5 shadow-none border-secondary border-opacity-25 text-sm">
                            <option value="IMPORTANT" {{#notice}}{{#isImportant}}selected{{/isImportant}}{{/notice}}>중요</option>
                            <option value="GENERAL" {{^notice}}selected{{/notice}} {{#notice}}{{#isGeneral}}selected{{/isGeneral}}{{/notice}}>일반</option>
                            <option value="EVENT" {{#notice}}{{#isEvent}}selected{{/isEvent}}{{/notice}}>이벤트</option>
                            <option value="SYSTEM" {{#notice}}{{#isSystem}}selected{{/isSystem}}{{/notice}}>시스템</option>
                        </select>
                    </div>
                    <div class="col-md-9">
                        <label class="form-label small fw-bold text-dark mb-2">공지사항 제목</label>
                        <input type="text" name="title" value="{{#notice}}{{title}}{{/notice}}" class="form-control py-2.5 shadow-none border-secondary border-opacity-25 text-sm" placeholder="공지사항 제목을 입력해주세요" required>
                    </div>
                </div>

                <!-- Editor -->
                <div class="mb-4">
                    <label class="form-label small fw-bold text-dark mb-2">본문 내용</label>
                    <div class="fh-editor-container">
                        <div class="fh-editor-toolbar d-flex flex-wrap gap-1">
                            <button type="button" class="btn btn-icon btn-sm"><span class="material-symbols-outlined fs-5">format_bold</span></button>
                            <button type="button" class="btn btn-icon btn-sm"><span class="material-symbols-outlined fs-5">format_italic</span></button>
                            <button type="button" class="btn btn-icon btn-sm"><span class="material-symbols-outlined fs-5">format_underlined</span></button>
                            <div class="vr mx-2 opacity-10"></div>
                            <button type="button" class="btn btn-icon btn-sm"><span class="material-symbols-outlined fs-5">format_align_left</span></button>
                            <button type="button" class="btn btn-icon btn-sm"><span class="material-symbols-outlined fs-5">format_align_center</span></button>
                            <button type="button" class="btn btn-icon btn-sm"><span class="material-symbols-outlined fs-5">format_list_bulleted</span></button>
                            <div class="vr mx-2 opacity-10"></div>
                            <button type="button" class="btn btn-icon btn-sm"><span class="material-symbols-outlined fs-5">image</span></button>
                            <button type="button" class="btn btn-icon btn-sm"><span class="material-symbols-outlined fs-5">link</span></button>
                        </div>
                        <textarea name="content" class="fh-editor-content" placeholder="공지사항 내용을 작성해주세요..." required>{{#notice}}{{content}}{{/notice}}</textarea>
                    </div>
                </div>

                <!-- File Upload (Future Implementation) -->
                <div class="mb-0">
                    <label class="form-label small fw-bold text-dark mb-2">첨부 파일 (PDF, DOCX, HWP) - <small class="text-secondary">현재는 비활성화됨</small></label>
                    <div class="file-drop-zone opacity-50">
                        <span class="material-symbols-outlined icon-upload">upload_file</span>
                        <p class="small fw-medium text-dark mb-1">파일 업로드 기능은 준비 중입니다.</p>
                        <p class="text-secondary" style="font-size: 11px;">최대 20MB 이하의 문서 파일만 가능합니다.</p>
                        <button type="button" class="btn btn-white btn-sm px-4 py-2 mt-3 shadow-sm border border-secondary border-opacity-25 fw-bold rounded-2" disabled>파일 선택</button>
                    </div>
                </div>
            </div>

            <!-- Bottom Actions -->
            <div class="d-flex align-items-center justify-content-end gap-3 pt-4">
                <button type="button" onclick="location.href='/admin/notices'" class="btn btn-light px-4 py-2.5 rounded-lg border border-secondary border-opacity-10 bg-white small fw-bold text-secondary">취소</button>
                <button type="submit" class="btn btn-primary px-4 py-2.5 rounded-lg fw-bold shadow-md border-0 small">{{#notice}}수정하기{{/notice}}{{^notice}}게시하기{{/notice}}</button>
            </div>
        </div>
    </form>
</div>
{{> layout/admin-footer}}
